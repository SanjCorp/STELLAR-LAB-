# Copia este archivo como backend/.env y pon tus valores reales.
# backend/.env está en .gitignore: NUNCA lo subas al repositorio.
#
# Sin estas dos variables, el backend funciona solo con datos simulados.

# URL del proyecto (Supabase > Project Settings > API)
SUPABASE_URL=https://ybtgkwftjkyhacunbami.supabase.co

# Clave SECRETA (sb_secret_...). Solo para el backend: jamás en el frontend ni en el ESP32.
SUPABASE_SECRET_KEY=

# Contraseña de acceso del equipo (opcional). Si está vacía, la app entra sin contraseña.
# En Vercel se define en Settings > Environment Variables.
APP_PASSWORD=
